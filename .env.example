# ═══════════════════════════════════════════════════════════════
# Application
# ═══════════════════════════════════════════════════════════════
APP_NAME="CodeBlitz Microservice"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# ═══════════════════════════════════════════════════════════════
# Supabase (Required)
# ═══════════════════════════════════════════════════════════════
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ═══════════════════════════════════════════════════════════════
# PISTON API (Required)
# ═══════════════════════════════════════════════════════════════
PISTON_URL=http://localhost:2000
PISTON_EXECUTE_TIMEOUT=30
PISTON_MAX_RETRIES=3
PISTON_MAX_CONCURRENT=5

# Language Versions (match your PISTON installation)
PISTON_PYTHON_VERSION=3.10.0
PISTON_JAVA_VERSION=15.0.2
PISTON_CPP_VERSION=10.2.0

# ═══════════════════════════════════════════════════════════════
# OpenAI (Required for variant generation)
# ═══════════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.2
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# ═══════════════════════════════════════════════════════════════
# Azure AI Foundry (Optional - alternative to OpenAI)
# ═══════════════════════════════════════════════════════════════
USE_AZURE_AI_FOUNDRY=false
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com
AZURE_AI_FOUNDRY_API_KEY=your-azure-key

# ═══════════════════════════════════════════════════════════════
# Generation Settings
# ═══════════════════════════════════════════════════════════════
MAX_GENERATION_RETRIES=3
MAX_VALIDATION_RETRIES=2
SIMILARITY_THRESHOLD=0.92
